# Bu dosyayı kopyalayın:  cp .env.example .env
# Gerçek değerleri .env içine yazın (.env git'e gitmez).

# ESP8266 (su + gaz)
ESP_BASE_URL=http://172.20.10.2
ESP_DEVICE_ID=esp8266_001

# Shelly Plug S (elektrik)
SHELLY_DEVICE_IP=192.168.137.43
SHELLY_DEVICE_ID=shelly_plug_001

# PostgreSQL HTTP API (opsiyonel)
POSTGRES_API_BASE_URL=http://localhost:3000/api

# Firebase (Flutter — Firebase Console > Project settings)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app

FIREBASE_API_KEY_WEB=your-web-api-key
FIREBASE_APP_ID_WEB=1:000000000000:web:xxxxxxxx
FIREBASE_MEASUREMENT_ID=G-XXXXXXXX

FIREBASE_API_KEY_ANDROID=your-android-api-key
FIREBASE_APP_ID_ANDROID=1:000000000000:android:xxxxxxxx

FIREBASE_API_KEY_IOS=your-ios-api-key
FIREBASE_APP_ID_IOS=1:000000000000:ios:xxxxxxxx
FIREBASE_IOS_BUNDLE_ID=com.example.carbonFootprintCalculationApp
